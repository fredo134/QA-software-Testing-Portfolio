    {
      "name": "users",
      "item": [
        {
          "name": "list_users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Verify response status code is 200 OK\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Verify response time is under 1 second\r",
                  "pm.test(\"Response time is less than 2000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "// 3. Validate user array structure\r",
                  "pm.test(\"Response contains data array with users\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property('data');\r",
                  "    pm.expect(jsonData.data).to.be.an('array');\r",
                  "    pm.expect(jsonData.data.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "// 4. Validate user object schema\r",
                  "pm.test(\"User object contains expected fields\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    var firstUser = jsonData.data[0];\r",
                  "    pm.expect(firstUser).to.have.all.keys('id', 'email', 'first_name', 'last_name', 'avatar');\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?page=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "creat user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Verify status code is 201 Created\r",
                  "pm.test(\"Status code is 201 Created\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "// 2. Validate request body details match response\r",
                  "pm.test(\"Created user details match payload\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.name).to.eql(\"Imoh Effiong\");\r",
                  "    pm.expect(jsonData.job).to.eql(\"QA Automation Engineer\");\r",
                  "});\r",
                  "\r",
                  "// 3. Verify ID and createdAt generation\r",
                  "pm.test(\"Response contains generated id and createdAt\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property('id');\r",
                  "    pm.expect(jsonData).to.have.property('createdAt');\r",
                  "});\r",
                  "\r",
                  "// 4. Store generated user ID as an environment variable\r",
                  "const jsonData = pm.response.json();\r",
                  "pm.environment.set(\"user_id\", jsonData.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
